{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build C",
            "type": "shell",
            "command": "gcc",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": "build"
        },
        {
            "label": "run C",
            "type": "shell",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "build C",
            "group": "test"
        }
    ]
}
